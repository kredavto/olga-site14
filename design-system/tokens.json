{
  "$name": "Olga Design System",
  "$source": "rep1–rep5.jpeg",
  "color": {
    "neutral": {
      "ivory":    { "value": "#F6F3EF", "use": "основной фон" },
      "sand":     { "value": "#EFE9E1", "use": "фон чередующихся секций, карточка" },
      "clay":     { "value": "#DED3C6", "use": "границы, плейсхолдер фото" },
      "stone":    { "value": "#9A9490", "use": "вторичный текст" },
      "espresso": { "value": "#352E2C", "use": "тёмные секции, кнопка, заголовки" },
      "ink":      { "value": "#1F1A18", "use": "основной текст" }
    },
    "accent": {
      "ochre":      { "value": "#8E621C", "source": "rep5" },
      "ochreSoft":  { "value": "#B8894A" },
      "terracotta": { "value": "#AA5013", "source": "rep2" },
      "sea":        { "value": "#6F8D9D", "source": "rep3" },
      "sage":       { "value": "#989F9D", "source": "rep3" }
    },
    "sky": {
      "1": { "value": "#D9E5F1" },
      "2": { "value": "#ABCCEF" },
      "3": { "value": "#669FD4" },
      "4": { "value": "#4476A7" },
      "$use": "градиент анимируемого фона (rep4)"
    },
    "$ratio": "85% нейтраль / 10% тёмный якорь / 5% акцент"
  },
  "typography": {
    "families": {
      "display": { "value": "Playfair Display", "fallback": "Cormorant Garamond, Georgia, serif", "source": "rep5, rep3, rep4" },
      "ui":      { "value": "Jost", "fallback": "Poppins, system-ui, sans-serif", "source": "rep1, rep2" }
    },
    "scale": {
      "hero":    { "size": "clamp(3.5rem, 9vw, 8.5rem)", "lineHeight": 0.95, "tracking": "-0.02em", "family": "display" },
      "h1":      { "size": "clamp(2.5rem, 5vw, 4.5rem)", "lineHeight": 1.05, "tracking": "-0.01em", "family": "display" },
      "h2":      { "size": "clamp(1.75rem, 3vw, 2.75rem)", "lineHeight": 1.1, "tracking": "-0.01em", "family": "display" },
      "h3":      { "size": "1.25rem", "lineHeight": 1.3, "weight": 500, "family": "ui" },
      "bodyLg":  { "size": "1.125rem", "lineHeight": 1.65, "family": "ui" },
      "body":    { "size": "1rem", "lineHeight": 1.65, "family": "ui" },
      "caption": { "size": "0.8125rem", "lineHeight": 1.4, "family": "ui" },
      "label":   { "size": "0.75rem", "lineHeight": 1.2, "tracking": "0.14em", "transform": "uppercase", "weight": 500, "family": "ui" }
    },
    "measure": "68ch"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px", "11": "160px", "$base": "8px" },
  "layout": {
    "container": "1440px",
    "gutter": "24px",
    "columns": 12,
    "paddingX": { "mobile": "24px", "tablet": "48px", "desktop": "80px" },
    "allowedGrids": ["12", "4-4-4", "6-6"],
    "breakpoints": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1440px" }
  },
  "rhythm": {
    "utilityBar": "48px",
    "heroMinHeight": "88vh",
    "pauseAfterHero": { "mobile": "96px", "desktop": "128px" },
    "sectionPaddingY": { "mobile": "96px", "desktop": "128px" },
    "cardGap": "24px",
    "cardInner": "16px"
  },
  "radius": { "sm": "8px", "md": "16px", "lg": "24px", "pill": "999px", "arch": "50% 50% 0 0 / 38% 38% 0 0" },
  "shadow": { "card": "0 2px 12px rgba(31,26,24,.06)", "lift": "0 12px 32px rgba(31,26,24,.10)" },
  "motion": { "ease": "cubic-bezier(.22,.61,.36,1)", "fast": "180ms", "base": "320ms", "slow": "640ms", "ambient": "40s" }
}
